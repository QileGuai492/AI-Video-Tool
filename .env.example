# 环境变量示例文件
# 复制为 .env 后填入真实值，禁止提交 .env 到 Git

# 应用
APP_ENV=local
DEBUG=true
SECRET_KEY=please_change_me
JWT_SECRET=please_change_me_jwt
JWT_EXPIRE_MINUTES=1440
# 对外公网地址，用于把本地 /uploads 转成外部可访问 URL
PUBLIC_BASE_URL=http://localhost:8000

# 数据库
# 本地开发可用 SQLite：sqlite:///./ai_video.db
DATABASE_URL=postgresql://ai_video:change_me@localhost:5432/ai_video

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 外部 API Key（申请后填入）
MINIMAX_API_KEY=
TONGYI_API_KEY=
CLAUDE_API_KEY=

# 硅基流动 SiliconFlow（OpenAI 兼容）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_LLM_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_IMAGE_MODEL=Qwen/Qwen-Image
SILICONFLOW_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B

# Agnes AI（免费全模态 API）
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_LLM_MODEL=agnes-2.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# 阿里云 OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=

# 文件存储
STORAGE_BACKEND=local

# 文件上传限制
MAX_UPLOAD_SIZE_MB=200
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
ALLOWED_AUDIO_TYPES=mp3,wav
ALLOWED_VIDEO_TYPES=mp4

# 成本控制
DEFAULT_COST_LIMIT=50
QUALITY_THRESHOLD=7.5
# 是否启用视觉语言模型质量评估（需要 Agnes/SiliconFlow 等真实 LLM）
QUALITY_VLM_ENABLED=false

# 任务编排
ORCHESTRATOR_BACKEND=simple
# 视频模型限流：同一任务间隔秒数（如 1 次/分钟 = 60）
VIDEO_TASK_INTERVAL_SECONDS=60

# 视频后处理（超分 / 插帧 / 锐化）
VIDEO_POSTPROCESS_ENABLED=false
VIDEO_TARGET_RESOLUTION=1080p
VIDEO_INTERPOLATE_FACTOR=2
VIDEO_SHARPEN=true

# 角色一致性 VLM 检查（需要支持图片的 LLM）
CHARACTER_CONSISTENCY_CHECK_ENABLED=false
CHARACTER_CONSISTENCY_THRESHOLD=0.6
CHARACTER_CONSISTENCY_MAX_RETRIES=1
